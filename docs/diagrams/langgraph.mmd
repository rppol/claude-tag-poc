flowchart TB
  START(["mention arrives"]) --> Q[("queue<br/>claim · lease · 3 tries")]
  Q --> ROUTER{"router<br/><small>worth working on?</small>"}
  ROUTER -.->|"no"| DROP(["dropped"])
