  LIB --> PLAN["planner<br/><small>decompose</small>"]

  PLAN --> EXEC["executor<br/><small>MCP tools</small>"]
  PLAN --> ANA["analyst<br/><small>A2A task</small>"]
  EXEC -.->|"write tool?<br/>interrupt()"| HUM{{"human approves"}}
  HUM --> EXEC

  EXEC --> REV{"reviewer<br/><small>claims backed?</small>"}
  ANA --> REV
  REV -->|"no · max 2"| PLAN
  REV -->|"yes"| POST["post reply"] --> SCRIBE["scribe<br/><small>write memory</small>"] --> DONE(["done"])

