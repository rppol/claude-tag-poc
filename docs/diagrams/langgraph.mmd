flowchart TB
  START(["mention arrives"]) --> Q[("queue<br/><small>claim · lease · 3 tries</small>")]
  Q --> LIB["librarian<br/><small>scope + context</small>"]
  LIB --> AG["agent<br/><small>tool-calling loop</small>"]

  AG -.->|"write tool<br/>interrupt()"| HUM{{"human approves<br/><small>run parks in 'waiting' —<br/>the lease must not reclaim it</small>"}}
  HUM --> AG

  AG --> W["writer<br/><small>decides what humans read</small>"]
  W --> V{"verifier<br/><small>mechanical, no model:<br/>every number and name<br/>must appear in evidence</small>"}
  V -->|"unsupported"| W
  V -->|"clean"| POST["post reply"] --> SCRIBE["scribe<br/><small>write only what a tool<br/>asserted or a human confirmed</small>"] --> DONE(["done"])

  classDef built stroke:#4FD8AA,fill:#16332B,color:#DCEFE8,stroke-width:1.5px
  classDef design stroke:#9578C4,fill:#241D31,color:#C6B9D9,stroke-dasharray:5 4
  classDef mech stroke:#EDAE55,fill:#33281A,color:#F0DEC0
  class START,Q,POST,DONE built
  class LIB,AG,HUM,W,SCRIBE design
  class V mech
