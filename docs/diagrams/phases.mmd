flowchart TB
  P1["<b>1 · Shadow</b><br/>1 channel · 6 people<br/>read-only, no memory"]
  P2["<b>2 · Assisted</b><br/>3 channels · 25 people<br/>memory on, writes ask first"]
  P3["<b>3 · Org-wide</b><br/>all 100 · ambient off"]
  P4["<b>4 · Ambient</b><br/>opt-in per channel"]

  P1 --> D1{"useful without<br/>a human rewriting it?"}
  D1 -->|"no"| P1
  D1 -->|"yes"| P2 --> D2{"scope holds under<br/>a red-team pass?"}
  D2 -->|"no"| FIX["fix the predicate"] --> D2
  D2 -->|"yes"| P3 --> D3{"spend predictable?<br/>no scope incident?"}
  D3 -->|"no"| TUNE["tighten budgets"] --> D3
  D3 -->|"yes"| P4

  classDef ph stroke:#4FD8AA,fill:#16332B,color:#DCEFE8,stroke-width:1.5px
  classDef gate stroke:#EDAE55,fill:#33281A,color:#F0DEC0
