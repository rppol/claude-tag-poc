flowchart TB
  S(["T2 entered"]) --> PL["<b>planner</b><br/><small>claim · evidence · action<br/>confidence · alternatives_considered</small>"]

  PL --> MECH{"runtime check<br/><small>alternatives_considered empty?</small>"}
  MECH -->|"yes → auto-objection<br/>severity: high"| CR
  MECH -->|"no"| CR["<b>critic</b><br/><small>sees the proposal OBJECT only,<br/>never the planner's reasoning.<br/>Own budget: 2 tool calls.</small>"]

  CR --> FIL{"objection filter<br/><small>in code, before the planner sees it</small>"}
  FIL -->|"kind=contradicted<br/>with no cites"| DROP(["discarded"])
  FIL -->|"target resolves to<br/>no real field"| DROP
  FIL --> EX{"any of five bounds hit?<br/><small>accept · no high-severity ·<br/>round ceiling · tokens · wall-clock</small>"}

  EX -->|"no"| PL
  EX -->|"accept, or nothing<br/>high-severity survives"| OK(["→ writer"])
  EX -->|"ceiling hit, and a<br/>high-severity objection<br/>still stands"| TB{"surviving kind?"}

  TB -->|"irreversible / scope"| HUM["<b>human gate</b><br/><small>both positions rendered,<br/>plus the one test<br/>that would settle it</small>"]
  TB -->|"anything else"| DOWN["<b>ship downgraded</b><br/><small>assertions become hedges ·<br/>a tool action becomes a proposal ·<br/>the objection is attached verbatim</small>"]

  NOTE["<small>No exit is 'the planner wins<br/>because the loop ended'.</small>"]

  classDef design stroke:#9578C4,fill:#241D31,color:#C6B9D9,stroke-dasharray:5 4
  classDef mech stroke:#EDAE55,fill:#33281A,color:#F0DEC0
  classDef bad stroke:#DB6A50,fill:#33201B,color:#F0C9BE
  classDef built stroke:#4FD8AA,fill:#16332B,color:#DCEFE8,stroke-width:1.5px
  classDef note fill:none,stroke:none,color:#8B7FA0
  class PL,CR,HUM,DOWN design
  class MECH,FIL,EX,TB mech
  class DROP bad
  class S,OK built
  class NOTE note
