flowchart TB
  IN(["@Claude mentioned"]) --> LIB["<b>librarian</b> — no model<br/><small>fetch thread · retrieve inside the scope predicate<br/>· extract entities with the verifier's own extractor</small>"]
  LIB --> P{"tier predicate<br/><small>pure code, no model call, no drop edge</small>"}

  P -->|"CAUSAL.test(question)"| T2["<b>T2 · debate</b> — 4-6 model calls<br/><small>planner ⇄ critic → writer</small>"]
  P -->|"the last draft failed<br/>the verifier"| T2
  P -->|"otherwise"| T1["<b>T1</b> — 2-3 model calls<br/><small>agent tool loop → writer</small>"]

  T1 -.->|"a proposed tool whose<br/>policy is not auto"| T2

  T1 --> V{"<b>verifier</b> — no model<br/><small>set-difference over claim tokens</small>"}
  T2 --> V
  V -->|"unsupported"| T1
  V -->|"clean"| POST(["post to thread"])
  POST -.->|"off the critical path —<br/>the person is already reading"| SC["<b>scribe</b><br/><small>what survives this run</small>"]

