flowchart TB
  IN(["@Claude mentioned"]) --> LIB["<b>librarian</b> — no model<br/><small>fetch thread · retrieve inside the scope predicate<br/>· extract entities with the verifier's own extractor</small>"]
  LIB --> P{"tier predicate<br/><small>pure code — no model call</small>"}

  P -->|"retryReason == VERIFY_FAIL"| T2
  P -->|"CAUSAL.test(question)"| T2["<b>T2 · debate</b> — 4-6 calls<br/><small>planner ⇄ critic → writer</small>"]
  P -->|"no tool hint<br/>and < 160 chars"| T0["<b>T0 · direct</b> — 1 call<br/><small>writer</small>"]
  P -->|"otherwise"| T1["<b>T1 · fast</b> — 2-3 calls<br/><small>agent tool loop → writer</small>"]

  T1 -.->|"Gate B: a proposed tool<br/>whose policy is not auto"| T2

  T0 --> V{"<b>verifier</b> — no model<br/><small>set-difference over claim tokens</small>"}
  T1 --> V
  T2 --> V
  V -->|"unsupported"| T1
  V -->|"clean"| POST(["post to thread"])
  POST -.->|"off the critical path —<br/>the person is already reading"| SC["<b>scribe</b><br/><small>what survives this run</small>"]

  NOTE["<small>Two of the five nodes on the common path<br/>run no model at all. The librarian was a<br/>small-model call until a measurement showed<br/>nothing downstream read its output — 18% of<br/>every token, rendered and discarded.</small>"]

