flowchart LR
  EV["inbound event<br/>channel = C_INCIDENTS"] --> BIND["channel_binding<br/>lookup"]
  BIND --> SCOPE["identity scope<br/>eng-claude"]
  REQ["request body<br/>attacker-controlled"] -. "never used for scope" .-> BIND

  SCOPE --> Q["vector query<br/>WHERE scope_id = :identity<br/>AND ... then rank"]
  TXT["question text"] --> EMB["embedding"] --> Q
  Q --> VS[("vector store<br/>Qdrant via mem0")]
  VS --> TOPK["top-k in scope"] --> CTX["context bundle"]

  OTHER[("#sales memories<br/>different scope")] -. "not reachable:<br/>excluded in the predicate,<br/>not filtered after" .-x Q
