flowchart TB
  subgraph IN["◈ what the agents can see"]
    AL["#alerts-prod<br/><small>Alertmanager, synthetics</small>"]
    TH["the thread<br/><small>who said what</small>"]
  end

  IN --> GATE{"policy gate<br/><small>allowlist · budget · always-ask</small>"}
  GATE --> VAULT["credential vault<br/><small>secret added at egress,<br/>never inside the sandbox</small>"]

  VAULT --> GR["Grafana<br/><small>dashboards · PromQL · panel image</small>"]
  VAULT --> PD["PagerDuty<br/><small>oncall · escalation · MTTA</small>"]
  VAULT --> GH["GitHub<br/><small>deploys · diffs · revert PR</small>"]

  GR & PD & GH --> OUT["answer in the thread"]
  OUT --> AUD[("audit log<br/><small>every call, every actor</small>")]

  classDef design stroke:#9578C4,fill:#241D31,color:#C6B9D9,stroke-dasharray:5 4
  classDef ext stroke:#EDAE55,fill:#33281A,color:#F0DEC0
  classDef built stroke:#4FD8AA,fill:#16332B,color:#DCEFE8,stroke-width:1.5px
  class GATE,VAULT,AUD design
  class GR,PD,GH,AL ext
  class TH,OUT built
  style IN fill:#15111C,stroke:#2F2540,color:#9C8FB0
