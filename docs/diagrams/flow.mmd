flowchart TB
  subgraph FAST["◈ inside Slack's 3-second deadline"]
    direction LR
    U["@Claude<br/>mentioned"] --> L["listener<br/><small>ack + 1 insert</small>"]
    L --> Q[("runs<br/>unique event_id")]
  end

  L -->|"200 OK · ~40ms"| SL["Slack"]
  SL -.->|"no ack? retry<br/>same event_id"| L

  subgraph SLOW["◈ after the ack — no deadline, so this can be slow"]
    direction LR
    Q --> W["worker<br/><small>claim · lease · retry</small>"] --> AG["agents"] --> R["reply<br/>in thread"]
  end

  classDef built stroke:#4FD8AA,fill:#16332B,color:#DCEFE8,stroke-width:1.5px
  classDef ext stroke:#EDAE55,fill:#33281A,color:#F0DEC0
  classDef design stroke:#9578C4,fill:#241D31,color:#C6B9D9,stroke-dasharray:5 4
  class U,L,Q,W,R built
  class SL ext
  class AG design
  style FAST fill:#15111C,stroke:#2F2540,color:#9C8FB0
  style SLOW fill:#15111C,stroke:#2F2540,color:#9C8FB0
